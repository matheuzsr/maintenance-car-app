# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://maintenance_car:maintenance_car@localhost:5433/maintenance_car?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
NOTIFICATION_SCAN_INTERVAL_MS=900000

# JWT - replace both secrets with long, independent random values
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Web Push (VAPID) - required when notification delivery is enabled.
# Generate one key pair per deployment and keep the private key secret.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=replace-with-your-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-your-vapid-private-key
WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,*.notify.windows.com

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3001

# Frontend public runtime configuration
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000
