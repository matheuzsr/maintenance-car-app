{
  "name": "maintenance-car",
  "version": "0.1.0",
  "private": true,
  "description": "Vehicle maintenance platform workspace",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "workspaces": [
    "app/backend",
    "app/frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names backend,frontend --prefix-colors magenta,cyan \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run start:dev --workspace @maintenance-car/backend",
    "dev:frontend": "npm run dev --workspace @maintenance-car/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @maintenance-car/backend",
    "build": "npm run build --workspaces --if-present",
    "api:generate": "npm run openapi:export --workspace @maintenance-car/backend && npm run generate --workspace @maintenance-car/api-contract",
    "prisma:generate": "npm run prisma:generate --workspace @maintenance-car/backend",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace @maintenance-car/backend",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace @maintenance-car/backend",
    "prisma:seed": "npm run prisma:seed --workspace @maintenance-car/backend",
    "start:worker:dev": "npm run start:worker:dev --workspace @maintenance-car/backend",
    "start:all": "docker compose up -d postgres redis && npm run prisma:migrate:deploy && npm run start:dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.6.0",
    "sharp": "^0.35.0"
  },
  "overrides": {
    "sharp": "$sharp"
  }
}
